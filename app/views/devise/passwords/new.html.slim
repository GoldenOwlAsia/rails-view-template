.my-4.text-xl.font-bold.tracking-tight.text-primary
  | Forgot your password?
= simple_form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :post }) do |f|
  .flex.flex-col.gap-2
    = f.input :email,
              label: false,
              required: true,
              autofocus: true,
              input_html: { autocomplete: 'email', class: 'w-full' }
  .form-actions
    = f.button :submit, 'Send me reset password instructions', class: 'w-full'

p.mt-2.text-sm.leading-6
  |  Suddenly remembered your password?
  a class="font-semibold text-primary hover:text-secondary" href="/users/sign_in"
    |  Sign In

= render 'devise/shared/links'
