- provide(:title, 'Users')

= render BreadcrumbComponent.new(crumbs: [{ name: 'Dashboard', path: admin_root_path }, { name: 'Users' }])

.flex.justify-between.items-center.mb-4
  = search_form_for @q, url: admin_users_path, class: 'flex px-3 pt-3 flex-wrap items-end gap-4 mb-3', data: { turbo_frame: 'search' } do |f|
    .flex-1 class="max-w-[250px]"
      = f.search_field :first_name_or_last_name_or_email_cont,
                      placeholder: 'Full Name or Email',
                      class: 'block w-full rounded-md border border-gray-300 px-3 py-2 focus:border-blue-500 focus:ring focus:ring-blue-200 focus:ring-opacity-50'

    .flex.gap-2
      = f.submit 'Filter', class: 'text-white bg-blue-700 hover:bg-blue-800 focus:ring-4 focus:ring-blue-300 font-medium rounded-lg text-sm px-5 py-2.5 focus:outline-none w-full sm:w-auto'
      = link_to 'Reset',
admin_users_path,
class: 'text-gray-900 bg-white border border-gray-300 focus:outline-none hover:bg-gray-100 focus:ring-4 focus:ring-gray-200 font-medium rounded-lg text-sm px-5 py-2.5 w-full sm:w-auto text-center'

  = link_to 'New',
new_admin_user_path,
class: 'text-white bg-blue-700 hover:bg-blue-800 focus:ring-4 focus:ring-blue-300 font-medium rounded-lg text-sm px-5 py-2.5 focus:outline-none w-full sm:w-auto'

== render 'collection'
