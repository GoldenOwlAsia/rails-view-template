- provide(:title, 'New User')

= render BreadcrumbComponent.new(crumbs: [{ name: 'Dashboard', path: admin_root_path }, { name: 'Users', path: admin_users_path }, { name: 'New' }])

.max-w-4xl.mx-auto.px-4.py-8
  .bg-white.shadow-md.rounded-lg.p-6
    h2.text-2xl.font-bold.mb-6 New User

    = simple_form_for @user, url: admin_users_path, method: :post, data: { turbo: false } do |f|
      == render 'form', f: f
