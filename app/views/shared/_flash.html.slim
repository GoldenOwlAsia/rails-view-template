#flash class="z-[1001] fixed top-5 right-5"
  - flash.each do |type, message|
    - toast_color = case type.to_sym
    -  when :notice then 'bg-blue-200 text-blue-500 white:bg-blue-800 white:text-blue-200'
    -  when :alert  then 'bg-red-200 text-red-500 white:bg-red-800 white:text-red-200'
    -  when :success then 'bg-green-200 text-green-500 white:bg-green-800 white:text-green-200'
    -  when :error then 'bg-red-200 text-red-500 white:bg-red-800 white:text-red-200'
    -  else 'bg-gray-200 text-gray-500 white:bg-gray-800 white:text-gray-200'

    - toast_icon = case type.to_sym
    -  when :alert  then 'circle-alert'
    -  when :success then 'circle-check'
    -  when :error then 'circle-x'
    -  else 'info'

    #toast.transition.transform.duration-700.hidden.flex.items-center.w-full.max-w-xs.p-4.mb-4.text-gray-500.bg-white.rounded-lg.shadow.gap-2[
      role="alert"
      data-controller="notifications icons"
      data-notifications-target="alert"
      data-notification-hidden-value="true"
      data-notification-delay-value="3000"
      data-transition-enter-from="opacity-0 translate-x-6"
      data-transition-enter-to="opacity-100 translate-x-0"
      data-transition-leave-from="opacity-100 translate-x-0"
      data-transition-leave-to="opacity-0 translate-x-6"
      data-action="awesome@window->notification#show"
    ]
      .inline-flex.items-center.justify-center.flex-shrink-0.w-8.h-8.rounded-lg class="#{toast_color}"
        i data-lucide="#{toast_icon}"
      .ms-3.text-sm.font-normal
        = message
      button.ms-auto.-mx-1.5.-my-1.5.bg-white.text-gray-400.hover:text-gray-900.rounded-lg.focus:ring-2.focus:ring-gray-300.p-1.5.hover:bg-gray-100.inline-flex.items-center.justify-center.h-8.w-8.white:text-gray-500.white:hover:text-white.white:bg-gray-800.white:hover:bg-gray-700[
        type="button"
        data-dismiss-target="#toast"
        aria-label="Close"
        data-action="notification#hide"
      ]
        i data-lucide="circle-x"

  - flash.clear
