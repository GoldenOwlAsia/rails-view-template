#toast.transition.transform.duration-700.hidden.flex.items-center.w-full.max-w-xs.p-4.mb-4.text-gray-500.bg-white.rounded-lg.shadow.gap-2[
  role="alert"
  data-controller="notifications icons"
  data-notifications-target="alert"
  data-notification-hidden-value="true"
  data-notification-delay-value="3000"
  data-transition-enter-from="opacity-0 translate-x-6"
  data-transition-enter-to="opacity-100 translate-x-0"
  data-transition-leave-from="opacity-100 translate-x-0"
  data-transition-leave-to="opacity-0 translate-x-6"
  data-action="awesome@window->notification#show"
]
  .inline-flex.items-center.justify-center.flex-shrink-0.w-8.h-8.rounded-lg class="#{color}"
    i data-lucide="#{icon}"
  .ms-3.text-sm.font-normal
    = message
  button.ms-auto.-mx-1.5.-my-1.5.bg-white.text-gray-400.hover:text-gray-900.rounded-lg.focus:ring-2.focus:ring-gray-300.p-1.5.hover:bg-gray-100.inline-flex.items-center.justify-center.h-8.w-8.dark:text-gray-500.dark:hover:text-white.dark:bg-gray-800.dark:hover:bg-gray-700[
    type="button"
    data-dismiss-target="#toast"
    aria-label="Close"
    data-action="notification#hide"
  ]
    i data-lucide="circle-x"
