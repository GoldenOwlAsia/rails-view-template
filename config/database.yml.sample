# ENV.fetch only falls back when the key is absent. A key present but empty —
# which is exactly what copying .env.sample gives you — returns "", so every
# value here uses .presence to treat empty the same as unset.
default: &default
  adapter: postgresql
  encoding: unicode
  pool: <%= ENV["RAILS_MAX_THREADS"].presence || 5 %>
  host: <%= ENV["DB_HOST"].presence || "localhost" %>
  port: <%= ENV["DB_PORT"].presence || 5432 %>
  username: <%= ENV["DB_USERNAME"].presence %>
  password: <%= ENV["DB_PASSWORD"].presence %>

development:
  <<: *default
  database: <%= ENV["DB_NAME"].presence || "rails_boilerplate_development" %>

# The test database is never taken from DB_NAME: it is wiped on every run, so
# pointing it at the development database by accident has to be impossible.
test:
  <<: *default
  database: rails_boilerplate_test

staging:
  <<: *default
  database: <%= ENV["DB_NAME"].presence || "rails_boilerplate_staging" %>

production:
  <<: *default
  database: <%= ENV["DB_NAME"].presence || "rails_boilerplate_production" %>
